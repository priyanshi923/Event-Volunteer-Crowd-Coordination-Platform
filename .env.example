# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy to .env for local Docker Compose overrides (do not commit .env to Git)
# ==============================================================================

# --- Service Host Ports ---
FRONTEND_PORT=3000
BACKEND_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# --- Backend Application Settings ---
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:////app/data/event_platform.db
CORS_ORIGINS=*

# --- Frontend Build Configuration ---
VITE_API_BASE_URL=/api

# --- Grafana Demonstration Credentials (DEMO ONLY - CHANGE IN PRODUCTION) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Jira Cloud REST API Configuration ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=EVCP

# --- GitHub Actions Runtime Reporting (backend/github_service.py) ---
# Reading workflow runs works without a token for public repos. To let the running platform
# trigger .github/workflows/runtime-report.yml, create a fine-grained token scoped to this repo
# with "Actions: Read and write" and set GITHUB_TOKEN.
GITHUB_REPOSITORY=priyanshi923/Event-Volunteer-Crowd-Coordination-Platform
GITHUB_TOKEN=
GITHUB_RUNTIME_WORKFLOW=runtime-report.yml
GITHUB_WORKFLOW_REF=main
GITHUB_REPORT_ON_STARTUP=true
# Minutes between heartbeat reports while running (0 = off)
GITHUB_REPORT_INTERVAL_MIN=0
EVCP_INSTANCE_NAME=local-dev
