# --- Python & Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# --- Testing, Coverage & Cache ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# --- Databases & Runtime Storage ---
*.db
*.sqlite
*.sqlite3
backend/event_platform.db
event_platform.db
backend/uploads/*
!backend/uploads/.gitkeep

# --- Environment & Sensitive Files ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
secrets.json

# --- Node.js & Frontend Build Outputs ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
.vite/
frontend/.vite/
.oxlint_cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- IDEs & Code Editors ---
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# --- Logs & Temporary Files ---
*.log
logs/
tmp/
temp/
scratch/

# --- Docker & Monitoring Runtime Data ---
.docker/
prometheus_data/
grafana_data/
data/


# --- Local native tooling (Prometheus/Grafana binaries, runtime data) ---
tools/
simulation/jira_sim_store.json
